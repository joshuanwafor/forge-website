# Canonical site origin, no trailing slash. Feeds canonical URLs, the sitemap,
# RSS and the absolute og:image URL — so a wrong value points every social share
# and every crawler at somebody else's site.
#
# Must be set at BUILD time, not just at runtime: NEXT_PUBLIC_* values are
# inlined during `next build`. On Vercel, leaving it unset falls back to the
# deployment's own domain rather than to a guess.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (required for the tour, waitlist and newsletter forms) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Zoho Campaigns (optional) ---
# Leave blank to skip the marketing sync entirely; the forms still work.
ZOHO_API_URL=https://campaigns.zoho.com/api/v1.1
ZOHO_AUTH_TOKEN=
ZOHO_WAITLIST_KEY=
ZOHO_TOUR_LIST_KEY=
ZOHO_NEWSLETTER_KEY=
