# Canonical site origin. Used for canonical URLs, sitemap, RSS and social cards.
NEXT_PUBLIC_SITE_URL=https://forgehub.in

# --- Supabase (required for the tour, waitlist and newsletter forms) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Zoho Campaigns (optional) ---
# Leave blank to skip the marketing sync entirely; the forms still work.
ZOHO_API_URL=https://campaigns.zoho.com/api/v1.1
ZOHO_AUTH_TOKEN=
ZOHO_WAITLIST_KEY=
ZOHO_TOUR_LIST_KEY=
ZOHO_NEWSLETTER_KEY=
